# ==========================================
# MOOMOO TRADING CONFIGURATION
# ==========================================
# Copy this file to .env and update with your actual values
# IMPORTANT: Never commit your actual .env file with real credentials!

# ==========================================
# EXISTING OPENAI AND API CONFIGURATIONS
# ==========================================
OPENAI_API_BASE=""
OPENAI_API_KEY=""
ALPHAADVANTAGE_API_KEY=""
JINA_API_KEY=""

# ==========================================
# MCP SERVICE PORTS
# ==========================================
MATH_HTTP_PORT=8000
SEARCH_HTTP_PORT=8001
TRADE_HTTP_PORT=8002
GETPRICE_HTTP_PORT=8003

# ==========================================
# AGENT CONFIGURATION
# ==========================================
AGENT_MAX_STEP=30
RUNTIME_ENV_PATH=""

# ==========================================
# MOOMOO (FUTU) REAL TRADING CONFIGURATION
# ==========================================

# Enable/Disable real trading mode
# Set to "true" to enable real trading via Moomoo API
# Set to "false" (default) for simulation mode
USE_MOOMOO=false

# OpenD Gateway Connection Settings
# OpenD is the gateway program that must be running to connect to Moomoo
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111

# Moomoo API Credentials
# Get these from your Moomoo account settings
MOOMOO_API_KEY=your_api_key_here
MOOMOO_SECRET_KEY=your_secret_key_here

# Trading unlock password
# This is required to enable trading operations
MOOMOO_UNLOCK_PASSWORD=your_trading_password_here

# Trading Environment
# REAL: Real trading with actual money
# SIMULATE: Paper trading with virtual money
MOOMOO_TRD_ENV=SIMULATE

# ==========================================
# RISK CONTROL PARAMETERS (Optional)
# ==========================================

# Maximum amount for a single trade (in USD)
MAX_SINGLE_TRADE=10000

# Maximum number of trades per day
MAX_DAILY_TRADES=50

# Maximum total position value (in USD)
MAX_POSITION_VALUE=100000

# ==========================================
# TESTING CONFIGURATION (Optional)
# ==========================================

# Use simulation mode even when USE_MOOMOO is true
# Useful for testing without risking real money
MOOMOO_SIMULATE=false

# ==========================================
# IMPORTANT SECURITY NOTES
# ==========================================
# 1. NEVER commit this file with real credentials to version control
# 2. Add .env to your .gitignore file
# 3. Keep your API keys and passwords secure
# 4. Start with SIMULATE mode before using REAL mode
# 5. Test with small amounts when first using REAL mode
# 6. Ensure OpenD is running before starting the agent
# ==========================================

# ==========================================
# GETTING STARTED
# ==========================================
# 1. Install Moomoo OpenD from https://openapi.moomoo.com/
# 2. Start OpenD program (it will listen on port 11111 by default)
# 3. Get your API credentials from Moomoo account settings
# 4. Copy this file to .env and update with your credentials
# 5. Install Python SDK: pip install futu-api
# 6. Set USE_MOOMOO=true to enable real trading
# 7. Start with MOOMOO_TRD_ENV=SIMULATE for testing
# 8. Only switch to MOOMOO_TRD_ENV=REAL after thorough testing
# ==========================================